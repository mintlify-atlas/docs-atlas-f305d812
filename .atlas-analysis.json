  "keyFeatures": [
    "Personalised UK attraction recommendations using cosine similarity on vector embeddings",
    "Swipe-based like/dislike interactions that update a user's preference profile in real time",
    "Multi-Head Encoding (MHE) + sentence-transformer embeddings for hybrid user profiling",
    "MMR (Maximal Marginal Relevance) re-ranking to balance relevance and diversity",
    "Geo-area filtering by country, region, or county",
    "Onboarding bulk-import of previously visited attractions",
    "JWT authentication with automatic access token refresh",
    "pgvector-backed PostgreSQL database for fast nearest-neighbour search",
    "React Native / Expo mobile frontend with NativeWind styling",
    "Docker Compose setup for backend + database"
  ],
  "publicApiSurface": [
    "POST /api/user/register/",
    "POST /api/user/token/",
    "POST /api/user/token/refresh",
    "POST /api/user/preferences/",
    "POST /api/user/reset/",
    "GET  /api/recommendations/",
    "GET  /api/recommendations/search?q=",
    "GET  /api/recommendations/history/liked",
    "POST /api/recommendations/like/{id}",
    "POST /api/recommendations/dislike/{id}",
    "POST /api/recommendations/like/bulk/"
  ]
}
